# LongHorizonOS example environment. Copy to .env and fill in.
LHOS_DB_PATH=artifacts/lhos.db
LHOS_TRACE_DIR=artifacts/traces
LHOS_CHECKPOINT_DIR=artifacts/checkpoints
# LLM access is out of scope for the MVP; the MockLLM adapter is used instead.
LHOS_PLANNER_MODEL=mock-planner
LHOS_WORKER_MODEL=mock-worker
LHOS_RECONCILER_MODEL=mock-reconciler
LHOS_API_KEY=
