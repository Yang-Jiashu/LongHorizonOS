.DS_Store

# Runtime data is not committed; audit reports are.
artifacts/*
!artifacts/.gitkeep
!artifacts/audit/
!artifacts/traces/.gitkeep
!artifacts/checkpoints/.gitkeep
!artifacts/benchmark_results/.gitkeep
!artifacts/reports/.gitkeep
